# URLs de remoteEntry.js de cada Micro Frontend.
# En desarrollo coinciden con los puertos locales.
# En producción, reemplazar por las URLs desplegadas de cada remote.

VITE_BODY_REMOTE_URL=http://localhost:3001/remoteEntry.js
VITE_BRAIN_REMOTE_URL=http://localhost:3002/remoteEntry.js
VITE_SIGNAL_REMOTE_URL=http://localhost:3003/remoteEntry.js
VITE_DECODER_REMOTE_URL=http://localhost:3004/remoteEntry.js

# 1 = tiempos de demo (~2–3 s). 0 = inmediato (tests).
VITE_DEMO_TIMING=1
